{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "fs:default",
      "allow": [{ "path": "$HOME/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$HOME/**" }]
    },
    {
      "identifier": "fs:allow-create",
      "allow": [{ "path": "$HOME/**" }]
    },
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://www.sgedu.com.br/*" }, 
        { "url": "https://www.sgedu.com.br" },
        { "url": "https://saev.abc.br/*" },
        { "url": "https://saev.abc.br" },
        { "url": "https://api.saev.abc.br/*" },
        { "url": "https://api.saev.abc.br" }
      ],
      "deny": []
    }
  ]
}
